--- ./dotfiles/xmobar/.xmobarrc	2021-12-29 12:20:07.434784679 +0100
+++ /home/danioche/.xmobarrc	2021-12-29 17:29:36.778796206 +0100
@@ -1,16 +1,28 @@
-Config { font = "xft:Source Code Pro:size=10,Hack:size=9,Font Awesome:size=9" ,
+Config {
+       font = "xft:Source Code Pro:size=10,Hack:size=9,Font Awesome:size=9" ,
+       additionalFonts = ["xft: Font Awesome 5 Free Solid:pixelsize=12"
+   			, "xft:Font Awesome 5 Brands:pixelsize=12"] ,
        bgColor = "black" , fgColor = "grey" , position = Top ,
        lowerOnStart = True ,
        commands = [
        		Run Network "wlp1s0"
-       		    ["-L","0","-H","15000","--normal","green","--high","red","-S","True","--template","<fc=#04d9ff></fc> <rx>|<tx>"] 10 ,
+       		    ["-L","0",
+		     "-H","15000",
+		     "--normal","green",
+		     "--high","red",
+		     "-S","True",
+		     "--template","<rx> <tx>"] 10 ,
 		Run MultiCpu
        		    ["-L","3","-H","50","--normal","green","--high","red","-t","<fc=#04d9ff></fc> <bar>"] 10 ,
 		Run Memory ["-t","<fc=#04d9ff></fc> <usedratio>%"] 10 ,
 		Run Swap ["-t","<fc=#04d9ff>S</fc> <usedratio>%"] 10 ,
+		Run DiskU [("/", "<used>/<size>"),  ("sda7", "<usedbar>")]               
+                  ["-L", "20", "-H", "50", "-m", "1", "-p", "3",
+                  "--normal", "grey50", "--high", "#a0522d",
+                  "--low", "#2f4f4f"] 20,
 		Run Com "/home/danioche/.xmonad/get-Battery.sh" [] "myBatt" 60,
 		Run Com "/home/danioche/.xmonad/get-Weather.sh" [] "myWeather" 1800,
        		Run Date "%a %b %_d %Y %H:%M:%S" "date" 10],
 	sepChar= "%" ,
 	alignSep = "}{" ,
-	template = "%multicpu% | %memory% %swap% | %wlp1s0% }<fc=#ee9a00> %date%</fc>{ %myWeather%|%myBatt%" }
+	template = "%multicpu% | %memory% %swap% | <fc=#04d9ff></fc> %disku% | %wlp1s0% }<fc=#ee9a00> %date%</fc>{ %myWeather%|%myBatt%" }
