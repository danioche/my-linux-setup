--- ./dotfiles/xmonad/.xmonad/get-Battery.sh	2022-02-26 11:27:56.104007567 +0100
+++ /home/danioche/.xmonad/get-Battery.sh	2022-03-02 20:50:50.118994254 +0100
@@ -1,44 +1,47 @@
 #!/bin/bash
 
-# -- Battery
-#
+# -- Battery This will depend on your configuration, if you have
+# -- symbolics links to the battery hardware info you can do something
+# -- like this
 # BatStatus=`cat ~/BAT1/capacity`
 # Status=`cat ~/BAT1/status`
+
 #
+# You will need acpi installed!
 BatStatus=`acpi | cut -d, -f2 | cut -d% -f1 | xargs`
 Status=`acpi | cut -d, -f1 | cut -d: -f2 | xargs`
 
-
+# Status icons uses AwesomeFont
 case $Status in
 
     "Full")
-        PercStatus="$Status <fc=#00cc00></fc>"
+        PercStatus="$Status <fc=#00cc00><fn=1></fn></fc>"
     ;;
 
     "Charging")
-        PercStatus="<fc=#ffff00>⚡</fc>"
+        PercStatus="<fc=#ffff00><fn=1></fn></fc>"
     ;;
 
     "Discharging")
 
         if [ $BatStatus -gt 10 ]; then
-            PercStatus="<fc=#ff0000></fc>"
+            PercStatus="<fc=#ff0000><fn=1></fn></fc>"
         fi
 
         if [ $BatStatus -gt 20 ]; then
-            PercStatus="<fc=#ff9933></fc>"
+            PercStatus="<fc=#ff9933><fn=1></fn></fc>"
         fi
 
         if [ $BatStatus -gt 40 ]; then
-            PercStatus="<fc=#009933></fc>"
+            PercStatus="<fc=#009933><fn=1></fn></fc>"
         fi
 
         if [ $BatStatus -gt 60 ]; then
-            PercStatus="<fc=#00cc00></fc>"
+            PercStatus="<fc=#00cc00><fn=1></fn></fc>"
         fi
 
         if [ $BatStatus -gt 95 ]; then
-            PercStatus="<fc=#00cc00></fc>"
+            PercStatus="<fc=#00cc00><fn=1></fn></fc>"
         fi
 
     ;;
diff -ruN ./dotfiles/xmonad/.xmonad/get-Battery.sh~ /home/danioche/.xmonad/get-Battery.sh~
--- ./dotfiles/xmonad/.xmonad/get-Battery.sh~	1970-01-01 01:00:00.000000000 +0100
+++ /home/danioche/.xmonad/get-Battery.sh~	2022-02-28 21:53:53.018321560 +0100
@@ -0,0 +1,49 @@
+#!/bin/bash
+
+# -- Battery
+#
+# BatStatus=`cat ~/BAT1/capacity`
+# Status=`cat ~/BAT1/status`
+#
+BatStatus=`acpi | cut -d, -f2 | cut -d% -f1 | xargs`
+Status=`acpi | cut -d, -f1 | cut -d: -f2 | xargs`
+
+
+case $Status in
+
+    "Full")
+        PercStatus="$Status <fc=#00cc00></fc>"
+    ;;
+
+    "Charging")
+        PercStatus="<fc=#ffff00>⚡</fc>"
+    ;;
+
+    "Discharging")
+
+        if [ $BatStatus -gt 10 ]; then
+            PercStatus="<fc=#ff0000><fn=1></fn></fc>"
+        fi
+
+        if [ $BatStatus -gt 20 ]; then
+            PercStatus="<fc=#ff9933><fn=1></fn></fc>"
+        fi
+
+        if [ $BatStatus -gt 40 ]; then
+            PercStatus="<fc=#009933><fn=1></fn></fc>"
+        fi
+
+        if [ $BatStatus -gt 60 ]; then
+            PercStatus="<fc=#00cc00><fn=1></fn></fc>"
+        fi
+
+        if [ $BatStatus -gt 95 ]; then
+            PercStatus="<fc=#00cc00><fn=1></fn></fc>"
+        fi
+
+    ;;
+
+esac
+
+
+echo "$PercStatus  $BatStatus%"
