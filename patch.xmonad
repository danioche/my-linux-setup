diff -ruN ./dotfiles/xmonad/.xmonad/set-Brightness.sh /home/danioche/.xmonad/set-Brightness.sh
--- ./dotfiles/xmonad/.xmonad/set-Brightness.sh	2022-02-26 11:27:56.104007567 +0100
+++ /home/danioche/.xmonad/set-Brightness.sh	2023-08-23 20:37:14.666465241 +0200
@@ -1,14 +1,15 @@
 #!/usr/bin/env bash
 
-currBright=`xrandr --verbose | grep -e "Brightness" | cut -d " " -f2`
+currBright=`xrandr --verbose | grep -e "Brightness" | cut -d " " -f2 | head -n 1`
+
 newBright=$(echo "$currBright - 0.1" | bc -l )
 
 if [ "$1" = "+" ]; then
 
-    newBright=$(echo "$currBright + 0.1" | bc -l )
+   newBright=$(echo "$currBright + 0.1" | bc -l )
 
 fi
 
-echo "Setting from $currBright to $newBright..."
+echo "Setting from $currBright to $newBright " >> set-Brightness.log
 
-`xrandr --output eDP-1 --brightness $newBright`
+$(xrandr --output eDP-1 --brightness "$newBright")
diff -ruN ./dotfiles/xmonad/.xmonad/set-Brightness.sh~ /home/danioche/.xmonad/set-Brightness.sh~
--- ./dotfiles/xmonad/.xmonad/set-Brightness.sh~	1970-01-01 01:00:00.000000000 +0100
+++ /home/danioche/.xmonad/set-Brightness.sh~	2023-08-23 18:43:39.677980310 +0200
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+currBright=`xrandr --verbose | grep -e "Brightness" | cut -d " " -f2 | head -n 1`
+
+newBright=$(echo "$currBright - 0.1" | bc -l )
+
+if [ "$1" == "+" ]; then
+
+   newBright=$(echo "$currBright + 0.1" | bc -l )
+
+fi
+
+echo "Setting from $currBright to $newBright " >> set-Brightness.log
+
+$(xrandr --output eDP-1 --brightness "$newBright")
