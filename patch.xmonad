+
+myWorkspaces :: [String]        
+myWorkspaces = clickable $ map xmobarEscape ["F","W","O","4","5","6","7","8","9"]
+    where                                                                      
+      clickable l = [ "<action=xdotool key alt+" ++ show n ++ ">" ++ ws ++ "</action>" |
+                      (i,ws) <- zip [1..9] l, let n = i ]
 
